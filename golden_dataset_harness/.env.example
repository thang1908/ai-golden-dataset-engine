# OAuth2 Client Credentials and OpenAI-compatible vLLM endpoint.
VLLM_BASE_URL=https://your-vllm-host.example.com
VLLM_CLIENT_ID=replace-me
VLLM_CLIENT_SECRET=replace-me
VLLM_PROJECT_ID=replace-me
VLLM_MODEL=v-llm-v1-large

VLLM_TIMEOUT_SECONDS=120
VLLM_MAX_RETRIES=3
VLLM_MAX_TOKENS=1024
VLLM_MAX_IMAGE_BYTES=60000
VLLM_ENABLE_THINKING=false
VLLM_GUARDRAIL=off
VLLM_GUARD_OUTPUT_MODE=refuse
VLLM_TOKEN_REFRESH_SKEW_SECONDS=60
